# Copy to .env for local development. Never commit a real .env file --
# it's already in .gitignore.

# Port the HTTP server listens on. Most PaaS platforms (Cloud Run, Render,
# Railway) inject this automatically in production -- only needed for
# local development.
PORT=8080

# "development" or "production". Controls log verbosity. Never used to
# bypass a security check.
APP_ENV=development

# Comma-separated list of origins allowed to make cross-origin browser
# requests to this API (e.g. https://www.darweshgroup.com). Leave empty
# to allow none -- that's the correct default until a real frontend
# integration needs one.
ALLOWED_ORIGINS=

# --- Firebase Admin authentication (shared by several backend features) ---
# Two ways to authenticate -- set ONE of the two blocks below, not both.
#
# For local development: the full JSON contents of a Firebase service
# account key -- NOT a file path. Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key. Paste the entire
# downloaded file's contents as a single-line value here. NEVER commit
# the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# For production on Cloud Run: leave FIREBASE_SERVICE_ACCOUNT_JSON unset
# and set this instead -- the backend then authenticates via Application
# Default Credentials (the runtime service account Cloud Run attaches
# automatically), needing no downloaded key at all. Not a secret -- this
# project's Firebase project id is already public in js/firebase-init.js.
# The runtime service account needs roles/datastore.user,
# roles/firebaseauth.admin, and roles/iam.serviceAccountTokenCreator
# (granted to itself) -- see docs/EMAIL_OTP.md's "Firebase Admin
# authentication" section for why each is needed.
FIREBASE_PROJECT_ID=

# --- Legacy link-based password-reset email endpoint (milestone 3) ---
# A Firebase Admin credential (either block above), plus
# RESET_PASSWORD_CONTINUE_URL, RESEND_API_KEY, and RESET_EMAIL_FROM, must
# all be set for POST /api/v1/auth/forgot-password to exist at all --
# with any missing or invalid, the server starts fine and logs why, but
# doesn't register the route (a 404, not a route that exists and
# silently fails). Kept as a fallback path alongside the email-OTP flow
# below, not replaced by it.

# Where the reset link in the (legacy) email points -- this project's own
# reset-password.html, never an arbitrary/caller-supplied URL.
RESET_PASSWORD_CONTINUE_URL=https://www.darweshgroup.com/reset-password.html

# --- Email OTP: signup verification + password recovery ---
# See docs/EMAIL_OTP.md for the full architecture. Requires a Firebase
# Admin credential (either block above) and OTP_HMAC_SECRET (below) to
# register the /api/v1/auth/email-otp/*, /api/v1/auth/signup/complete,
# and /api/v1/auth/password-reset/confirm routes at all. RESEND_API_KEY
# and RESET_EMAIL_FROM (shared with the legacy endpoint above -- same
# Resend account, a different template) additionally control delivery:
# both set -> real Resend delivery; either missing -> MockEmailSender in
# development (delivers nothing, used by tests), and in production the
# email-OTP routes are NOT registered at all -- mock email delivery must
# never run in production.

# A random, high-entropy secret used to HMAC-hash OTP codes before they're
# ever stored -- the plaintext code is never persisted. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this invalidates every OTP challenge currently in flight (a
# few minutes' worth at most, since codes expire quickly) -- never reuse
# this value for anything else, and never commit the real value.
OTP_HMAC_SECRET=

# From https://resend.com -- create a free account, verify a sending
# domain, generate an API key. Do NOT activate a paid plan without
# explicit approval -- the free tier (3,000 emails/mo, 100/day as of
# this writing) is what this project is scoped against.
RESEND_API_KEY=

# Must be an address on a domain you've verified with Resend.
RESET_EMAIL_FROM=Darwesh Group <no-reply@darweshgroup.com>

# --- Profile Architecture Phase 2: access-management endpoints ---
# The /api/v1/access/* endpoints (organization membership/ownership,
# role permission defaults, user permission overrides, effective-
# permissions read) need only a Firebase Admin credential (either block
# above) -- no separate secret. They register independently of the
# email-OTP endpoints above (not gated on OTP_HMAC_SECRET or an email
# provider), since they authenticate via a caller's existing Firebase ID
# token and never send email.

# --- MAM Sorani voice: KurdishTTS proxy (STT + TTS) ---
# Two INDEPENDENT capabilities, each gated on its own key -- see
# app.main.build_voice_handler. Neither key is ever sent to the browser,
# logged, or returned in any response; the browser only ever talks to
# THIS backend's /api/v1/mam/voice/* routes, which attach the real key
# server-side when calling https://www.kurdishtts.com. Leave both unset
# to disable Sorani voice entirely -- MAM's text chat and non-Sorani
# voice are completely unaffected either way.

# From https://www.kurdishtts.com -- create a free account, generate an
# API key with speech-to-text access. Enables POST /api/v1/mam/voice/stt.
KURDISHTTS_STT_KEY=

# From https://www.kurdishtts.com -- an API key with text-to-speech
# access (may be the same or a different key than the one above,
# depending on how your KurdishTTS account is set up). Enables
# POST /api/v1/mam/voice/tts. Do NOT activate a paid plan without
# explicit approval -- this integration is scoped against the free tier.
KURDISHTTS_TTS_KEY=

# --- Not yet used ---
# DATABASE_URL=
# REDIS_URL=
