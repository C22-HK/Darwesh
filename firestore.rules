rules_version = '2';

// Darwesh Group — Firestore Security Rules
// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// Roles live on users/{uid}.role: "customer" (default, self-assigned at
// signup) or "agent" (assigned manually by you in the Firestore console —
// see the note in agent-dashboard.html / the chat for how).
//
// Every user and listing also carries a companyId (see companies/{id}
// below) — the foundation for eventually hosting more than one real
// estate company on this same platform, each with its own agents/team
// visibility. signup.html asks for a company name and creates the
// company doc automatically the first time that name is used — every
// signup after that with the same name just joins it, no manual
// Firestore edit needed. Public browsing (Map/Buy) still pools all
// companies' listings together — only the agent-facing Team Listings
// view is scoped per company so far.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAgent() { return myRole() == 'agent'; }
    function isAdmin() { return myRole() == 'admin'; }
    function myCompanyId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        : null;
    }

    // ---- Profile Architecture: accountType / activeOrganizationId / permissions ----
    // Phase 1 (data model + rules only) additions. `role` above is
    // UNCHANGED and remains the sole source of truth for isAgent()/
    // isAdmin() -- everything below is a second, additive layer that
    // never widens what `role` already grants, per the Multi-Type
    // Profile Architecture plan §2.1/§2.5/§3 ("profile type, role,
    // organization membership and permissions must remain separated";
    // "UI hiding is not authorization").
    function myAccountType() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', null)
        : null;
    }
    // Phase 2.2: `myOrganizationId()` (Phase 1) was dead code -- grepped
    // the whole repo, confirmed it was never called by any rule, never
    // written by any frontend/backend code path, and never held real
    // data (zero production writers of users/{uid}.organizationId
    // existed). Removed rather than kept under a new name: a rules
    // helper reading this field would invite exactly the mistake this
    // phase exists to prevent -- a resolved-permissions-style lookup
    // that looks authoritative but isn't. The field itself is kept
    // (renamed to `activeOrganizationId` in the users/{uid} rule below)
    // as a pure UX/navigation pointer -- "which org am I currently
    // working in" -- resolved and validated server-side per request by
    // app.access.permission_ops/organization_ops (GET /me/organizations,
    // POST /me/active-organization), never by a rules function, and
    // NEVER checked by any authorization rule in this file. Organization
    // membership/ownership authorization continues to come exclusively
    // from organizations/{orgId}/members/{uid} (isOrgMember(),
    // hasOrgPermission()) and organizations/{orgId}.ownerId (orgOwnerId())
    // above -- unchanged.
    // accountType is self-settable ONLY to one of these descriptive,
    // non-authoritative values at signup (write-once, then admin/backend
    // only -- see the users/{uid} rule below). 'admin' is deliberately
    // EXCLUDED here -- that value is only ever assigned by an admin, even
    // though, per fail-closed design, self-declaring it would grant
    // nothing by itself (myPermissions() never trusts accountType alone).
    function isValidSelfAccountType(v) {
      return v in [
        'individual_customer', 'real_estate_agent', 'office_owner', 'office_employee',
        'professional_engineer', 'professional_designer', 'professional_lawyer',
        'professional_landscaping', 'cleaning_individual', 'cleaning_team_or_company_owner',
        'org_owner_residential_community', 'org_owner_developer',
        'org_owner_finance_provider', 'org_owner_furniture_store'
      ];
    }
    // Protected permissions (verbatim list from the approved architecture
    // plan) can NEVER be resolved true by hasPermission() below, for
    // ANY caller including one whose rolePermissionDefaults/
    // permissionOverrides somehow contained a protected:true entry --
    // defense in depth on top of the write-side guarantee that those two
    // collections/fields are themselves never directly client-writable
    // (see §2.6 below: they are backend/Admin-SDK-only). A protected
    // action must always be gated by isAdmin() directly at its call
    // site, never by hasPermission().
    function isProtectedPermissionKey(key) {
      return key in [
        'admin_access', 'manage_roles', 'manage_permissions', 'verify_profiles',
        'suspend_users', 'change_organization_owner', 'manage_platform_security'
      ];
    }
    // Resolved-permission computation, mirroring myRole()'s exact shape.
    // FAIL-CLOSED BY CONSTRUCTION: a missing/null accountType short-
    // circuits every branch below to {} via `&&`'s short-circuit
    // evaluation (no path ever falls through to any role's real
    // defaults), and every .get(key, false) defaults an unset key to
    // false rather than throwing or defaulting to true. There is no
    // code path here that can resolve to "true" for a key that isn't
    // explicitly, affirmatively granted.
    function roleDefaultPermissions() {
      return myAccountType() != null && exists(/databases/$(database)/documents/rolePermissionDefaults/$(myAccountType()))
        ? get(/databases/$(database)/documents/rolePermissionDefaults/$(myAccountType())).data.get('permissions', {})
        : {};
    }
    function myPermissionOverrides() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissionOverrides', {})
        : {};
    }
    function hasPermission(key) {
      return isSignedIn()
          && !isProtectedPermissionKey(key)
          && myPermissionOverrides().get(key, roleDefaultPermissions().get(key, false)) == true;
    }
    // Ownership lookups for the new collections below -- same
    // "read the referenced doc's own identity field" pattern as
    // myCompanyId(), used so a request/product/member rule can check
    // who owns the PARENT resource without trusting anything the
    // request itself claims.
    function orgOwnerId(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId))
        ? get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId
        : null;
    }
    // Phase 2.1 fix: this previously only checked exists() -- a PENDING
    // self-request or an INVITED-but-not-yet-accepted record satisfied
    // isOrgMember() the same as a real, active member, letting a mere
    // applicant pass the org-membership gate on `products` before ever
    // being approved. Now requires status=='active' explicitly (the
    // owner, checked first via orgOwnerId(), has no member doc at all
    // and is unaffected by this).
    function isOrgMember(orgId) {
      return isSignedIn() && (
        orgOwnerId(orgId) == request.auth.uid
        || (
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', 'pending') == 'active'
        )
      );
    }
    // Phase 2.1: an ACTIVE member's own org-scoped permission grants
    // (organizations/{orgId}/members/{uid}.permissions, writable only by
    // the trusted backend -- see the members match block below). {} for
    // anyone not an active member, by construction (never pending,
    // invited, rejected, or removed -- a removed/rejected record doesn't
    // exist at all, per organization_ops.py's delete-on-reject/-remove
    // design, so exists() alone already excludes those two states; the
    // explicit status=='active' check here excludes 'pending'/'invited').
    function orgMemberPermissions(orgId) {
      return isSignedIn()
          && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', 'pending') == 'active'
        ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('permissions', {})
        : {};
    }
    // Phase 2.1: org-scoped permission check -- ADDITIVE union of the
    // caller's global hasPermission(key) (their own accountType
    // defaults/overrides, unscoped) with this SPECIFIC org's own grant
    // to them, if any. An org-scoped grant can only ever ADD a
    // capability beyond the caller's global defaults for actions taken
    // inside that one org -- it can never revoke a globally-granted
    // permission, and (like hasPermission()) a protected key can never
    // resolve true through this path either, regardless of source. This
    // is what makes organization_ops.update_member_permissions'
    // (Phase 2) org-scoped grants actually consulted at write time,
    // reconciled with the same union model
    // app.access.permission_resolver.resolve_organization_permissions
    // mirrors on the backend's /me/permissions read side.
    function hasOrgPermission(orgId, key) {
      return isSignedIn()
          && !isProtectedPermissionKey(key)
          && (hasPermission(key) || orgMemberPermissions(orgId).get(key, false) == true);
    }
    function providerOwnerId(providerId) {
      return exists(/databases/$(database)/documents/serviceProviders/$(providerId))
        ? get(/databases/$(database)/documents/serviceProviders/$(providerId)).data.ownerId
        : null;
    }
    function companyOwnerId(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId))
        ? get(/databases/$(database)/documents/companies/$(companyId)).data.get('ownerId', null)
        : null;
    }

    // ---- Companies ----
    // A real estate company using this platform. Every user and listing
    // is tagged with a companyId. Any signed-in user can CREATE a new
    // company doc — that's how signup.html auto-creates one the first
    // time a name is used — but only if it doesn't already exist, so a
    // later signup can't overwrite an established company's name.
    // Editing or deleting an existing company is admin-only.
    //
    // Phase 3: additive schema extension only (no field renamed/removed,
    // no change to the `role`/`agentId`/`companyId` authorization
    // invariants above) -- mirrors organizations/{orgId}'s own
    // ownerId-locked, backend-mediated-membership pattern exactly, so a
    // real estate office can get the same premium profile treatment
    // (logo/verified/description/contactInfo/real team roster) the four
    // org_owner_* types already have, without touching the legacy
    // companyId/agentId authorization surface those still rely on
    // (BL-01/BL-04, unchanged). `ownerId` is OPTIONAL at create (unlike
    // organizations, where it's required) specifically so admin.html's
    // existing "Add Agent" flow (admin.html:3146-3151, which creates a
    // company doc under the ADMIN's own session with no ownerId at all)
    // keeps working completely unchanged -- an admin-created company
    // stays ownerless until a real office_owner claims it through a
    // future, separately-approved flow; it is NEVER inferable from
    // company name, admin session, or any other signal (BL-04
    // precedent). Once set, `ownerId` is locked for EVERY client-SDK
    // update, including isAdmin() -- same backend-mediated-ownership-
    // transfer reasoning as organizations.ownerId -- so an ownerless
    // legacy company cannot be self-claimed by a normal signed-in update
    // either; only a future, separately-approved backend endpoint may
    // assign it (see PHASE3_PROFILE_FIELD_CONTRACT.md's migration note
    // for the backfill plan, not executed this phase).
    match /companies/{companyId} {
      function isCompanyOwnerNow() {
        return isSignedIn() && resource.data.get('ownerId', null) == request.auth.uid;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && !exists(/databases/$(database)/documents/companies/$(companyId))
                    && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.get('verified', false) == false
                    && (!('location' in request.resource.data) || request.resource.data.location is map)
                    && (!('contactInfo' in request.resource.data) || request.resource.data.contactInfo is map)
                    && request.resource.data.keys().hasOnly([
                         'name', 'address', 'ownerId', 'description', 'logoUrl',
                         'coverImageUrl', 'city', 'district', 'location',
                         'contactInfo', 'verified', 'createdAt', 'updatedAt'
                       ]);
      // ownerId locked both directions via .get(,null) so a legacy
      // ownerless doc (missing the field entirely) stays ownerless
      // through this path -- see the block comment above.
      allow update: if request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
                    && (
                         isAdmin()
                         || (isCompanyOwnerNow()
                             && request.resource.data.get('verified', false) == resource.data.get('verified', false)
                             && (!('location' in request.resource.data) || request.resource.data.location is map)
                             && (!('contactInfo' in request.resource.data) || request.resource.data.contactInfo is map)
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly([
                                    'name', 'address', 'description', 'logoUrl', 'coverImageUrl',
                                    'city', 'district', 'location', 'contactInfo', 'updatedAt'
                                  ]))
                       );
      allow delete: if isAdmin();

      // Explicit, queryable roster of an office's employees -- separate
      // subcollection NAME from organizations/{orgId}/members on purpose
      // (not "members"), so a collection-group query over one never
      // accidentally returns docs from the other; same shape and same
      // security posture otherwise. An employee's presence here IS the
      // approval record (mirrors organizations/{orgId}/members'
      // comment) -- never client-writable by anyone, including
      // isAdmin(); only the backend's Admin SDK credential
      // (app.access.company_ops) creates/edits/removes an entry. This is
      // ADDITIVE to, not a replacement for, the existing
      // users/{uid}.companyId pointer that BL-01/BL-04's listing
      // authorization already relies on -- that legacy pointer is
      // unchanged and still the sole source of listing-level agent/
      // company authorization; this subcollection only adds a real,
      // queryable membership-status record for profile display.
      match /employees/{employeeUid} {
        allow read: if isAdmin()
                    || (isSignedIn() && companyOwnerId(companyId) == request.auth.uid)
                    || (isSignedIn() && request.auth.uid == employeeUid);
        allow write: if false;
      }
    }

    // ---- User profiles ----
    // Anyone signed in can read/create their own profile. An AGENT's
    // profile (name/email/photoURL) is publicly readable, even by a
    // guest with no account — listing.html shows the listing agent's
    // name and photo to every visitor, most of whom are browsing
    // anonymously, and agentName is already denormalized onto the public
    // `listings` collection anyway, so this isn't exposing anything new.
    // A customer's own profile stays private (isOwner/isAdmin only). A
    // user can update their own profile but NOT change their own role,
    // company, or assign themselves an agent (all three are set by you,
    // manually, in the Firestore console — see the note in
    // agent-dashboard.html / the chat for how). Only an admin profile
    // can change someone else's role, company, or agent assignment.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || resource.data.role == 'agent';
      // requestedRole records a signup applicant's stated interest in
      // becoming an agent (shown to admins as a "Wants Agent Access"
      // signal in admin.html) -- it is never trusted as an actual grant
      // (role above is the only field that matters for privilege), but
      // its own value is still constrained here to the two real options
      // rather than left open to any string a client cares to write.
      //
      // CREATE_ALLOWED_FIELDS below is an explicit allowlist (not a
      // denylist of just the dangerous ones) -- matches every field the
      // two real create paths actually send: the backend's Admin-SDK
      // signup flow (bypasses rules entirely, but this is the shape a
      // direct client create must also match) and admin.html's Add
      // Agent self-create step. An unlisted field (e.g. a client
      // sending `isAdmin: true` alongside a legitimate-looking
      // create) is rejected outright rather than silently accepted.
      //
      // BL-04 fix (BUSINESS_LOGIC_REMEDIATION.md): a self-create can
      // only set companyId directly when that company does NOT already
      // exist -- i.e. this signup is founding a brand-new company, the
      // one case where "typed this name first" is itself a meaningful
      // claim. Claiming an EXISTING company's id at create time is
      // rejected outright, for every caller, including admin.html's own
      // Add Agent flow (which resolves the company from the admin's own
      // trusted session first, then sets companyId in a SEPARATE update
      // under that trusted session -- see admin.html's comment at the
      // self-create call site). A signup that only wants to request
      // joining an existing company records that as
      // requestedCompanyId/requestedCompanyName instead (untrusted,
      // informational, granted no access by this rule) -- an admin must
      // explicitly set the real companyId later (admin.html's role-
      // promotion flow) for that request to become real access.
      // accountType (Profile Architecture Phase 1): self-settable ONLY to
      // one of the non-'admin' descriptive values (isValidSelfAccountType)
      // at signup -- purely a UI-routing hint, never itself checked by
      // any authorization rule (hasPermission()/myPermissions() ignore it
      // unless a matching rolePermissionDefaults doc exists, and that
      // collection is backend-only-writable, see below). activeOrganizationId
      // (Phase 2.2 -- renamed from the never-written, never-read
      // `organizationId`; see the removed myOrganizationId() comment
      // above for why) and permissionOverrides are deliberately NOT in
      // the create allowlist at all -- a brand-new user can never self-
      // claim an active organization or grant themselves any permission
      // override at signup; both are admin/backend-assigned only, after
      // the fact (activeOrganizationId's real write path is the
      // backend's POST /me/active-organization, which independently
      // re-validates real membership every time -- see
      // app.access.organization_ops.set_active_organization).
      allow create: if isOwner(uid) && request.resource.data.role == 'customer'
                    && (!('requestedRole' in request.resource.data)
                        || request.resource.data.requestedRole in ['customer', 'agent'])
                    && (!('companyId' in request.resource.data)
                        || request.resource.data.companyId == null
                        || !exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)))
                    && (!('accountType' in request.resource.data)
                        || isValidSelfAccountType(request.resource.data.accountType))
                    && request.resource.data.keys().hasOnly([
                         'email', 'displayName', 'firstName', 'lastName', 'phone',
                         'role', 'requestedRole', 'companyId', 'requestedCompanyId', 'requestedCompanyName',
                         'accountType',
                         'phoneVerified', 'phoneVerifiedAt', 'emailVerified', 'createdAt'
                       ]);
      // .get(field, null) rather than direct dot access for every locked
      // field below -- Firestore rules THROWS (and denies the whole
      // request) on a direct reference to a key that doesn't exist on
      // the document, rather than treating it as unset/null the way
      // JavaScript would. assignedAgentId is never actually set by any
      // write path in this codebase (grep confirms it -- read-only,
      // meant to be set by hand later), and requestedRole is absent on
      // any account created via admin.html's "Add Agent" flow -- a
      // direct comparison on either would have permanently denied every
      // self-edit those accounts ever make (found and verified against
      // a real Firestore emulator, not assumed), regardless of which
      // field the edit actually touched.
      //
      // UPDATE_ALLOWED_FIELDS is an explicit allowlist, not a denylist
      // of the four privileged fields -- account.html only ever needs
      // to change displayName/photoURL, so anything else (including a
      // field name this ruleset has never heard of, like `isAdmin` or
      // `verified`) is rejected outright for a self-edit, closing the
      // mass-assignment gap a pure denylist leaves open. isAdmin() below
      // still bypasses this for the real administrative-update path.
      // BL-03 fix (BUSINESS_LOGIC_REMEDIATION.md): commissionRate was
      // never in this allowlist at all, so agent-dashboard.html's own
      // "Save Rate" button silently failed for every real account --
      // added here, bounded to a sane 0-100 percentage (no such bound
      // existed anywhere before; this is the one place the field is
      // ever meant to be set, so it's a reasonable, narrowly-scoped
      // place to add it, not an invented business limit elsewhere).
      // permissionOverrides (Profile Architecture Phase 1): locked to its
      // prior value for EVERY client-SDK update, including an isAdmin()
      // session -- per explicit instruction, permission/access
      // configuration must be backend/Admin-SDK-mediated only, with no
      // client-writable path at all, not even an admin-gated one. Only
      // the backend's Admin SDK credential (bypasses these rules
      // entirely, same as create_user_profile/ensure_company today) may
      // ever change it -- see §2.6 of the architecture plan. accountType
      // and activeOrganizationId stay in the isAdmin()-bypassable branch
      // below (same admin-direct-write precedent as role/companyId
      // today) -- they are UI-routing/navigation-pointer fields, never
      // themselves a permission or membership grant (myPermissions()/
      // isOrgMember()/hasOrgPermission() never read or trust either one
      // -- organization authorization comes exclusively from
      // organizations/{orgId}/members/{uid} and .ownerId, unaffected by
      // whatever this field currently says).
      allow update: if request.resource.data.get('permissionOverrides', {}) == resource.data.get('permissionOverrides', {})
                    && (
                         (isOwner(uid)
                           && request.resource.data.role == resource.data.role
                           && request.resource.data.get('assignedAgentId', null) == resource.data.get('assignedAgentId', null)
                           && request.resource.data.get('companyId', null) == resource.data.get('companyId', null)
                           && request.resource.data.get('requestedRole', null) == resource.data.get('requestedRole', null)
                           && request.resource.data.get('accountType', null) == resource.data.get('accountType', null)
                           && request.resource.data.get('activeOrganizationId', null) == resource.data.get('activeOrganizationId', null)
                           && (!('commissionRate' in request.resource.data)
                               || ((request.resource.data.commissionRate is int || request.resource.data.commissionRate is float)
                                   && request.resource.data.commissionRate >= 0
                                   && request.resource.data.commissionRate <= 100))
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['displayName', 'photoURL', 'commissionRate']))
                         || isAdmin()
                       );
      allow delete: if isAdmin();

      // Per-user favorites and saved searches — only that user (ever) reads/writes.
      match /favorites/{listingId} {
        allow read, write: if isOwner(uid);
      }
      match /savedSearches/{searchId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Listings ----
    // Publicly readable ONLY when actually meant to be public: `status`
    // must be the one value that means "on the market" (`active` --
    // the only two values this app's own code ever writes are `active`
    // and `closed`, confirmed by grepping every listing-writing page;
    // no `draft`/`pending` status exists in the real schema, so none is
    // invented here -- an allowlist on `status` rather than a denylist
    // on `closed` means any future non-public status added later is
    // excluded by default, not by remembering to update this rule), and
    // `private` must not be set. A listing failing either check is
    // visible only to its own agent or an admin -- not to another,
    // unrelated agent, and not merely by being signed in.
    //
    // IMPORTANT Firestore semantics: allow get and allow list use the
    // SAME condition below on purpose. Because that condition reads
    // resource.data (not just request.auth), Firestore requires every
    // query against this collection to be structured so it can prove
    // the condition holds for every document the query could possibly
    // return -- an unconstrained getDocs(collection(db,'listings'))
    // with no where() clause is rejected outright for a non-admin,
    // non-listing-owner caller, not silently filtered. Public pages
    // must query with where('private','==',false) and
    // where('status','==','active') for their read to succeed; an
    // agent's own "my listings" query (already where('agentId','==',
    // <their own uid>)) or an admin's unfiltered read still work,
    // since those satisfy the isListingOwnerOrAdmin() branch instead.
    //
    // Plain dot-access below (not .get(field, default)) is deliberate
    // and load-bearing: empirically verified against the Firestore
    // emulator that resource.data.get(field, default) defeats the
    // query-provability analysis above -- a rule written that way still
    // denies a direct get() correctly, but silently ALLOWS an
    // unconstrained list() to return every document, including private
    // ones, which is exactly the leak this rule exists to close. Plain
    // access forces Firestore to require the matching where() clause.
    // This does mean a listing document that somehow lacks `private` or
    // `status` entirely would throw on access and read as denied (fails
    // closed, not open) for anyone but its own agent/admin -- CREATE
    // below now requires both fields for every new listing so this can
    // only affect pre-existing legacy documents, if any; see
    // AUTHORIZATION_REMEDIATION.md.
    function isListingPubliclyVisible() {
      return resource.data.private == false
          && resource.data.status == 'active';
    }
    function isListingOwnerOrAdmin() {
      return isAdmin() || (isAgent() && resource.data.agentId == request.auth.uid);
    }
    // BL-05 fix (BUSINESS_LOGIC_REMEDIATION.md): when admin.html converts
    // a sell submission into a real listing, the new doc carries a
    // sourceSubmissionId -- this re-enforces, at the rules layer, that
    // the referenced submission is a real 'sell' submission not already
    // converted, independent of admin.html's own client-side transaction
    // guard (defense in depth: a direct API call, or a future bug in
    // that transaction, still can't create two listings from the same
    // submission). A create with no sourceSubmissionId at all (the
    // ordinary "Add Listing" path) is unaffected.
    function isValidSourceSubmissionOrNone() {
      return !('sourceSubmissionId' in request.resource.data)
          || (
            get(/databases/$(database)/documents/submissions/$(request.resource.data.sourceSubmissionId)).data.type == 'sell'
            && !('convertedListingId' in get(/databases/$(database)/documents/submissions/$(request.resource.data.sourceSubmissionId)).data)
          );
    }
    // Part 13 / BL-05 numeric business-constraint fix: previously NONE
    // of this was enforced anywhere but a client-side form check (not a
    // security boundary) -- a negative/absurd price, or a negative
    // beds/baths/sqft, was accepted at the rules layer without question,
    // for both an agent's own listing and (more importantly) whatever a
    // submission's attacker-controllable numeric fields carried once
    // copied into admin.html's Add Listing form. `price` is required and
    // must be a positive number; beds/baths/sqft, when present, must be
    // non-negative numbers. No arbitrary maximum is imposed -- no such
    // product requirement exists in this app's own source.
    function hasSaneListingNumbers() {
      return 'price' in request.resource.data
          && (request.resource.data.price is int || request.resource.data.price is float)
          && request.resource.data.price > 0
          && (!('beds' in request.resource.data) || request.resource.data.beds is int || request.resource.data.beds is float)
          && (!('beds' in request.resource.data) || request.resource.data.beds >= 0)
          && (!('baths' in request.resource.data) || request.resource.data.baths is int || request.resource.data.baths is float)
          && (!('baths' in request.resource.data) || request.resource.data.baths >= 0)
          && (!('sqft' in request.resource.data) || request.resource.data.sqft is int || request.resource.data.sqft is float)
          && (!('sqft' in request.resource.data) || request.resource.data.sqft >= 0);
    }
    match /listings/{listingId} {
      allow get, list: if isListingPubliclyVisible() || isListingOwnerOrAdmin();
      // CREATE_ALLOWED_FIELDS: an explicit allowlist of every field the
      // real Add/Edit Listing form (agent-dashboard.html, admin.html)
      // actually sends at creation -- notably excludes `verified`.
      // `verified` is a reviewer/admin-only signal (see the update rule
      // below); an agent's own create request is rejected outright if
      // it tries to set verified:true on their own new listing, not
      // merely ignored -- so a request attempting to self-certify fails
      // loudly rather than silently creating an unverified listing.
      allow create: if (isAdmin() && isValidSourceSubmissionOrNone() && hasSaneListingNumbers())
                    || (isAgent()
                          && request.resource.data.agentId == request.auth.uid
                          && request.resource.data.companyId == myCompanyId()
                          && request.resource.data.get('verified', false) == false
                          && 'private' in request.resource.data
                          && 'status' in request.resource.data
                          && hasSaneListingNumbers()
                          && request.resource.data.keys().hasOnly([
                               'title', 'address', 'city', 'lat', 'lng', 'dealType', 'propertyType',
                               'price', 'beds', 'baths', 'sqft', 'img', 'amenities', 'private',
                               'agentId', 'agentName', 'companyId', 'status', 'createdAt'
                             ]));
      // UPDATE_ALLOWED_FIELDS: same allowlist idea for edits -- an agent
      // may change any of the normal listing fields on their own
      // listing, but NOT who it's attributed to (BL-01 fix,
      // BUSINESS_LOGIC_REMEDIATION.md). The original version of this
      // rule only checked resource.data.agentId==auth.uid -- who owns
      // it RIGHT NOW -- and never validated what the write itself
      // claimed about ownership afterward, so an agent could silently
      // reassign agentId/companyId to any value (including a real
      // colleague's uid, a different real company, or a fabricated
      // identity) in a normal edit, and an already admin-verified
      // listing's `verified:true` would survive that swap untouched.
      // agentId and companyId are now locked to their existing stored
      // value AND independently re-confirmed against the caller's own
      // identity -- an agent's edit can never move a listing to another
      // agent or company, full stop; only isAdmin() can reassign either.
      // agentName is locked the same way (immutable through this
      // branch) rather than re-derived live from the agent's profile --
      // the simpler, more robust choice given this rules file has no
      // way to safely replicate the frontend's own
      // "displayName || email" fallback logic; see
      // BUSINESS_LOGIC_REMEDIATION.md for why this is flagged as an
      // open product decision (keeping a listing's displayed agent name
      // in sync with later profile-name changes) rather than guessed at
      // here. Uses .get('agentName', null) rather than direct access on
      // both sides -- unlike agentId/companyId (which the create rule's
      // own equality checks already force to always be present, since a
      // direct comparison there throws on a missing field too),
      // agentName was never a required-at-create field, so a real or
      // test-fixture document lacking it entirely is expected and must
      // not permanently lock that listing out of every future edit.
      // `verified` still must stay exactly what it already was on
      // this branch, unaffected by (and no longer exploitable via) the
      // identity lock above.
      allow update: if isAdmin()
                    || (isAgent()
                          && hasSaneListingNumbers()
                          && resource.data.agentId == request.auth.uid
                          && request.resource.data.agentId == resource.data.agentId
                          && request.resource.data.agentId == request.auth.uid
                          && request.resource.data.get('agentName', null) == resource.data.get('agentName', null)
                          && request.resource.data.companyId == resource.data.companyId
                          && request.resource.data.companyId == myCompanyId()
                          && request.resource.data.get('verified', false) == resource.data.get('verified', false)
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly([
                                 'title', 'address', 'city', 'lat', 'lng', 'dealType', 'propertyType',
                                 'price', 'beds', 'baths', 'sqft', 'img', 'amenities', 'private',
                                 'status', 'updatedAt'
                               ]));
      allow delete: if (isAgent() && resource.data.agentId == request.auth.uid) || isAdmin();
    }

    // ---- Submissions (Sell form, viewing requests) ----
    // A signed-in customer can create a submission tagged with their own
    // uid, and can only ever read their own submissions back. A viewing
    // request (map.html) may also be submitted by a guest (uid == null) —
    // Request Viewing doesn't require an account. Only an admin can read
    // the full collection (Customer Services tab in admin.html) or change
    // a submission's status.
    match /submissions/{submissionId} {
      // BL-06 fix (BUSINESS_LOGIC_REMEDIATION.md): a 'viewing' submission
      // that names a listingId must reference a REAL listings document --
      // previously nothing checked this at all, so a direct API call
      // could forge a viewing request for a nonexistent property. This
      // get()/exists() call is server-side only and is NOT subject to
      // the listings collection's own read rule (a rules-internal
      // exists() check never exposes document data to the caller), so
      // this cannot be used to newly discover whether a private/closed
      // listing exists -- the caller already supplied the exact id
      // themselves, and existence alone (true either way for any real
      // listing regardless of private/status) isn't new information.
      // Full field-by-field cross-validation (does the submitted
      // address/price actually match that listing?) is NOT implemented
      // here -- documented as a remaining risk, not a silent gap; see
      // BUSINESS_LOGIC_REMEDIATION.md.
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.type in ['sell', 'viewing']
                    && (request.resource.data.uid == null
                        || (isSignedIn() && request.resource.data.uid == request.auth.uid))
                    && (request.resource.data.type != 'viewing'
                        || !('listingId' in request.resource.data)
                        || request.resource.data.listingId == null
                        || exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId)));
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      // sell.html starts uploading photos the moment they're added, not
      // when Submit is finally clicked -- whatever hasn't finished by
      // submit time keeps uploading in the background and patches this
      // same doc afterward, so listing creation never blocks on Storage.
      // That background patch runs as the same unauthenticated guest who
      // created the submission (sell.html has no login requirement), so
      // it can't be limited to isAdmin() the way other updates are --
      // narrowed instead to touching only the two property-photo fields,
      // and only while the submission is still pending (an admin has
      // full update rights regardless, e.g. once they start reviewing).
      //
      // verificationPhotoPath is deliberately NOT one of the guest-
      // patchable fields here (unlike photoUrls/photoUploadToken) --
      // this branch has no way to check WHO is calling it (guests have
      // no uid to compare against), so allowing it here would let any
      // unrelated, even unauthenticated, party overwrite which Storage
      // object a DIFFERENT person's submission claims as its identity-
      // verification photo, simply by knowing (or guessing) this
      // document's id -- exactly the "security by obscurity based only
      // on a Firestore document id" this was flagged for. The
      // verification photo's path now lives only in the
      // /verification/{token} subcollection below, gated by a real
      // capability the caller must already hold, not by this id alone.
      allow update: if isAdmin()
                    || (resource.data.status == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['photoUrls', 'photoUploadToken']));
      allow delete: if isAdmin();

      // Identity-verification photo metadata for this submission. The
      // document id here MUST equal this submission's own
      // photoUploadToken -- a value generated client-side
      // (crypto.randomUUID(), 122 bits of entropy) at submission-
      // creation time and never readable back from Firestore by anyone
      // but the submission's own owner or an admin (see the parent
      // `read` rule above -- and a guest's own submission, uid==null,
      // isn't even readable by them). The only party who can ever
      // construct a request that satisfies this match is therefore the
      // same browser session that created the submission and already
      // holds that token in memory -- a real, unguessable, server-
      // verified capability, not the submission id itself, which can
      // leak through many ordinary channels (a shared link, an admin
      // screen, browser history) that were never meant to grant write
      // access.
      match /verification/{token} {
        allow read: if isAdmin();
        // BL-07 fix (BUSINESS_LOGIC_REMEDIATION.md): `path` was
        // previously any string at all, even for the legitimate
        // token-holder -- letting a submitter point their OWN
        // verification record at an unrelated, already-public Storage
        // object (e.g. a real agent's public profile photo) instead of
        // a genuine selfie, defeating manual fraud review without
        // needing anyone else's credentials. Now constrained to the
        // actual shape sell.html's own upload flow produces
        // (sell-verification/{some token}/selfie.jpg) -- this can't
        // fully prove the referenced object is freshly-captured (that
        // needs a Storage-triggered Cloud Function, out of scope for a
        // rules-only fix, documented as remaining risk), but it does
        // close off pointing at any object outside this one dedicated,
        // admin-only-readable prefix.
        allow write: if token == get(/databases/$(database)/documents/submissions/$(submissionId)).data.get('photoUploadToken', null)
                      && get(/databases/$(database)/documents/submissions/$(submissionId)).data.status == 'pending'
                      && request.resource.data.keys().hasOnly(['path', 'setAt'])
                      && request.resource.data.path is string
                      && request.resource.data.path.matches('^sell-verification/[^/]+/selfie[.]jpg$');
        allow delete: if isAdmin();
      }
    }

    // ---- Agent financial ledger (accounting) ----
    // Each agent's own manually-entered income/expense/purchase records
    // for the Finances tab on agent-dashboard.html. Commission entries are
    // never stored here — they're calculated live from that agent's real
    // closed listings instead. Strictly owner-only: no agent can read or
    // write another agent's numbers; only an admin can read across all of
    // them.
    //
    // ALLOWED_FIELDS + basic type/positivity validation (BL-02 fix,
    // BUSINESS_LOGIC_REMEDIATION.md). The original rule had none of
    // this at all -- no field allowlist, and neither create nor update
    // checked amount's type or sign, so a negative, zero, or absurd
    // (e.g. 1e300) amount was accepted, and update didn't even
    // re-check agentId post-write, letting an agent silently reassign
    // their own transaction to another agent's account. `type` is
    // locked to the two real values this app ever writes (income/
    // expense) since that field directly decides which total a record
    // is summed into on the dashboard; `category` and `date` are
    // validated as non-empty/present but not further enum-restricted --
    // no product-defined maximum `amount` exists anywhere in this
    // app's own source, so none is invented here either, matching the
    // same "don't invent a business limit" reasoning.
    function isValidAgentTransaction() {
      return request.resource.data.type in ['income', 'expense']
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && (request.resource.data.amount is int || request.resource.data.amount is float)
          && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.date.size() > 0
          && request.resource.data.keys().hasOnly(['agentId', 'type', 'category', 'amount', 'date', 'note', 'createdAt']);
    }
    match /agentTransactions/{transactionId} {
      allow read: if isOwner(resource.data.agentId) || isAdmin();
      allow create: if isAdmin()
                    || (isAgent()
                          && request.resource.data.agentId == request.auth.uid
                          && isValidAgentTransaction());
      allow update: if isAdmin()
                    || (isOwner(resource.data.agentId)
                          && request.resource.data.agentId == resource.data.agentId
                          && request.resource.data.agentId == request.auth.uid
                          && isValidAgentTransaction());
      allow delete: if isOwner(resource.data.agentId) || isAdmin();
    }

    // ==================================================================
    // ---- Profile Architecture (Phase 1: data model + rules only) ----
    // ==================================================================
    // Everything below is new, additive collections for the Multi-Type
    // Profile Architecture. None of it changes, weakens, or is consulted
    // by any rule above this point -- role/isAgent()/isAdmin()/
    // isListingOwnerOrAdmin() and every AUTHZ-01..04/BL-01..09 rule stay
    // exactly as they were. See the approved architecture plan for the
    // full design; this phase is data model + rules + emulator tests
    // only -- no backend endpoint, no UI, ships nothing to production
    // without a separate explicit request.

    // ---- Organizations ----
    // Generalizes `companies` for the four NEW business/organization
    // types this phase introduces. Real-estate offices are NOT migrated
    // here yet -- they keep using `companies` unchanged (see plan §2.2
    // migration note); this collection's `type` allowlist below
    // deliberately excludes 'real_estate_office' for that reason.
    // Publicly readable (no isSignedIn() requirement) -- these are
    // meant to be public storefront/organization profiles a guest can
    // browse, the same reasoning `listings`' public-visibility branch
    // already uses for unauthenticated browsing.
    match /organizations/{orgId} {
      function isOrgOwnerNow() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }
      allow read: if true;
      // A signed-in user may found a brand-new organization, becoming
      // its owner -- same "self-registration, not a transfer" reasoning
      // `companies`' own create rule already uses. `verified` can never
      // be self-set true at creation (admin-only, same as
      // listings.verified). members/{ownerUid} is NOT auto-created here
      // (Firestore rules can't fan out a second document from one
      // write) -- ownerId on this doc is itself the authoritative owner
      // check everywhere below (orgOwnerId()/isOrgMember()), so no
      // membership doc is required for the owner to have full access.
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.type in [
                         'residential_community', 'developer_project',
                         'finance_provider', 'furniture_store'
                       ]
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.get('verified', false) == false
                    && (!('details' in request.resource.data) || request.resource.data.details is map)
                    && request.resource.data.keys().hasOnly([
                         'type', 'ownerId', 'name', 'description', 'logoUrl',
                         'coverImageUrl', 'city', 'district', 'location',
                         'contactInfo', 'details', 'verified', 'createdAt', 'updatedAt'
                       ]);
      // ownerId is locked for EVERY client-SDK update, including
      // isAdmin() -- ownership transfer is one of the explicitly
      // backend-mediated categories (plan §2.6); only a future backend
      // endpoint (Admin SDK, bypasses these rules) may reassign it.
      // `type` is likewise locked in the owner's own branch (an owner
      // can't relabel their org into a different business type after
      // the fact); an admin may still adjust `verified`/`type` directly,
      // matching the existing listings.verified admin-direct precedent.
      allow update: if request.resource.data.ownerId == resource.data.ownerId
                    && (
                         isAdmin()
                         || (isOrgOwnerNow()
                             && request.resource.data.type == resource.data.type
                             && request.resource.data.get('verified', false) == resource.data.get('verified', false)
                             && (!('details' in request.resource.data) || request.resource.data.details is map)
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly([
                                    'name', 'description', 'logoUrl', 'coverImageUrl',
                                    'city', 'district', 'location', 'contactInfo',
                                    'details', 'updatedAt'
                                  ]))
                       );
      allow delete: if isAdmin();

      // Explicit, queryable membership record for non-owner staff. An
      // employee's presence here IS the approval record (plan §2.2/§3):
      // there is no "request to join, auto-approved" path, and an
      // employee can never write their own entry. Organization access
      // changes are one of the explicitly backend-mediated categories
      // (plan §2.6) -- this subcollection is never client-writable at
      // all, by any role, including isAdmin(); only a future backend
      // endpoint (Admin SDK) creates/edits/removes a membership doc.
      match /members/{memberUid} {
        allow read: if isAdmin()
                    || (isSignedIn() && orgOwnerId(orgId) == request.auth.uid)
                    || (isSignedIn() && request.auth.uid == memberUid);
        allow write: if false;
      }
    }

    // ---- Service providers (Engineer/Designer/Lawyer/Landscaping/Cleaning) ----
    // One collection for all five service types (plan §2.3) rather than
    // five near-duplicated ones. Only 'cleaning' may use a non-
    // 'individual' providerType (team/company) -- the other four are
    // individual-only, per the approved plan.
    match /serviceProviders/{providerId} {
      function isProviderOwnerNow() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }
      function isValidServicesOffered(data) {
        return !('servicesOffered' in data)
            || data.servicesOffered.hasOnly([
                 'house_cleaning', 'apartment_cleaning', 'office_cleaning',
                 'deep_cleaning', 'move_in_cleaning', 'move_out_cleaning',
                 'post_construction_cleaning', 'post_renovation_cleaning',
                 'commercial_cleaning'
               ]);
      }
      allow read: if true;
      // An individual provider's document id must equal their own uid
      // (providerId == ownerId == uid) -- team/company cleaning
      // providers get a separate generated id, still owner-locked.
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.serviceType in ['engineer', 'designer', 'lawyer', 'landscaping', 'cleaning']
                    && request.resource.data.providerType in ['individual', 'team', 'company']
                    && (request.resource.data.providerType == 'individual' || request.resource.data.serviceType == 'cleaning')
                    && (request.resource.data.providerType != 'individual' || providerId == request.auth.uid)
                    && request.resource.data.get('verified', false) == false
                    && isValidServicesOffered(request.resource.data)
                    && request.resource.data.keys().hasOnly([
                         'serviceType', 'providerType', 'ownerId', 'displayName',
                         'companyName', 'photoOrLogoUrl', 'description', 'city',
                         'district', 'serviceAreas', 'experienceYears',
                         'specialties', 'servicesOffered', 'portfolio', 'teamSize',
                         'availableDays', 'availableHours', 'pricingModel',
                         'verified', 'createdAt', 'updatedAt'
                       ]);
      // ownerId is locked for EVERY client-SDK update, including
      // isAdmin() -- same backend-mediated-ownership-transfer reasoning
      // as organizations.ownerId above.
      allow update: if request.resource.data.ownerId == resource.data.ownerId
                    && (
                         isAdmin()
                         || (isProviderOwnerNow()
                             && request.resource.data.serviceType == resource.data.serviceType
                             && request.resource.data.providerType == resource.data.providerType
                             && request.resource.data.get('verified', false) == resource.data.get('verified', false)
                             && isValidServicesOffered(request.resource.data)
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly([
                                    'displayName', 'companyName', 'photoOrLogoUrl',
                                    'description', 'city', 'district', 'serviceAreas',
                                    'experienceYears', 'specialties', 'servicesOffered',
                                    'portfolio', 'teamSize', 'availableDays',
                                    'availableHours', 'pricingModel', 'updatedAt'
                                  ]))
                       );
      allow delete: if isAdmin() || isProviderOwnerNow();

      // Incoming customer requests, scoped under this specific provider's
      // own path -- never a flat, filterable-by-anyone collection. This
      // is the mechanism that satisfies "a cleaning provider must not
      // see another provider's private jobs" (plan §2.3/§3): a rule
      // would have to be written incorrectly to leak across providerId
      // path segments, not merely configured incorrectly.
      match /requests/{requestId} {
        allow create: if isSignedIn()
                      && request.resource.data.customerUid == request.auth.uid
                      && request.resource.data.get('status', 'pending') == 'pending'
                      && request.resource.data.keys().hasOnly(['customerUid', 'status', 'message', 'contactPhone', 'createdAt']);
        allow read: if isAdmin()
                    || (isSignedIn() && resource.data.customerUid == request.auth.uid)
                    || (isSignedIn() && providerOwnerId(providerId) == request.auth.uid);
        allow update: if isAdmin()
                      || (isSignedIn() && providerOwnerId(providerId) == request.auth.uid
                          && request.resource.data.customerUid == resource.data.customerUid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'providerNote', 'updatedAt']));
        allow delete: if isAdmin();
      }
    }

    // ---- Home goods / furniture catalog ----
    // Explicitly NOT an order/payment system this phase (plan §2.4) --
    // publish/browse/manage only.
    match /productCategories/{categoryId} {
      // Flat, parentId-linked tree seeded as data so new categories
      // (any depth) need zero rules/code changes -- just a new document.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /products/{productId} {
      // "Products must belong to the correct seller/organization. Do not
      // allow one store to modify another store's products" -- sellerId
      // is locked on update (BL-01 agentId-lock pattern) and every
      // write requires current ACTIVE membership in that SPECIFIC org
      // (isOrgMember, checked against the actual request/resource
      // sellerId, never trusted from elsewhere), gated further by the
      // create_product/edit_own_product permission -- Phase 2.1: now
      // checked via hasOrgPermission() rather than the bare global
      // hasPermission(), so a store owner's org-scoped grant to a
      // specific employee (organizations/{orgId}/members/{uid}.permissions,
      // Phase 2's update_member_permissions) is actually honored here,
      // not just recorded and ignored. hasOrgPermission() still falls
      // back to the caller's global accountType-level grant too (a
      // union, per this module's header) -- an org owner whose OWN
      // accountType defaults already include create_product/
      // edit_own_product (the expected seeding for an
      // org_owner_furniture_store accountType) needs no separate
      // per-org grant for their own store.
      allow read: if true;
      allow create: if isAdmin()
                    || (isOrgMember(request.resource.data.sellerId)
                        && hasOrgPermission(request.resource.data.sellerId, 'create_product')
                        && get(/databases/$(database)/documents/organizations/$(request.resource.data.sellerId)).data.type == 'furniture_store'
                        && request.resource.data.name is string
                        && request.resource.data.name.size() > 0
                        && request.resource.data.status in ['available', 'out_of_stock', 'hidden', 'sold_out']
                        && (request.resource.data.price is int || request.resource.data.price is float)
                        && request.resource.data.price >= 0
                        && request.resource.data.keys().hasOnly([
                             'sellerId', 'name', 'categoryId', 'description', 'price', 'currency',
                             'discountPrice', 'images', 'status', 'condition', 'dimensions',
                             'material', 'color', 'deliveryAvailable', 'createdAt', 'updatedAt'
                           ]));
      allow update: if isAdmin()
                    || (request.resource.data.sellerId == resource.data.sellerId
                        && isOrgMember(resource.data.sellerId)
                        && hasOrgPermission(resource.data.sellerId, 'edit_own_product')
                        && request.resource.data.status in ['available', 'out_of_stock', 'hidden', 'sold_out']
                        && (request.resource.data.price is int || request.resource.data.price is float)
                        && request.resource.data.price >= 0
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly([
                               'name', 'categoryId', 'description', 'price', 'currency',
                               'discountPrice', 'images', 'status', 'condition', 'dimensions',
                               'material', 'color', 'deliveryAvailable', 'updatedAt'
                             ]));
      allow delete: if isAdmin() || (isOrgMember(resource.data.sellerId) && hasOrgPermission(resource.data.sellerId, 'edit_own_product'));
    }

    // ---- Admin Access & Permissions ----
    // Per explicit instruction: ALL permission/access-configuration
    // writes -- protected or not -- go through a trusted backend/
    // Admin-SDK path only, atomically paired with an accessAuditLog
    // entry. These three collections are therefore `allow write: if
    // false` for every client-SDK caller, including an authenticated
    // isAdmin() session -- there is no admin-gated client path at all,
    // by design (plan §2.6, revised per explicit feedback). Reads stay
    // isAdmin()-gated client reads (rendering the admin panel carries no
    // atomicity/audit concern). Phase 1 ships no backend endpoint yet
    // (out of scope, see plan §5) -- these collections exist and are
    // seedable only via the Admin SDK directly (e.g. this phase's own
    // emulator test setup), not through any client surface, until a
    // later phase's backend endpoints are approved and built.
    match /permissionDefinitions/{key} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /rolePermissionDefaults/{accountTypeKey} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /accessAuditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Email OTP storage (backend-only) ----
    // Written and read exclusively by the backend's Firebase Admin SDK
    // credential (see backend/app/otp/store.py's FirestoreChallengeStore),
    // which bypasses these rules entirely, as any Admin SDK access does --
    // these two blocks change nothing about what the backend itself can
    // do. They exist so that fact isn't just implicit: no normal client
    // (signed in or not, including an admin) can ever read or write an
    // OTP challenge or reset/verify token directly, which would otherwise
    // let someone read a challenge's otpHash or forge a consumed/attempts
    // value straight through the client SDK.
    match /otpChallenges/{key} {
      allow read, write: if false;
    }
    match /otpResetTokens/{token} {
      allow read, write: if false;
    }

    // ---- Rate limiter storage (backend-only) ----
    // Written and read exclusively by the backend's Firebase Admin SDK
    // credential (see backend/app/auth/reset.py's FirestoreRateLimiter),
    // which bypasses these rules entirely, same reasoning as the two
    // OTP collections above. INFRA-01 fix (INFRASTRUCTURE_REMEDIATION.md).
    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
