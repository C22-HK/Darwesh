rules_version = '2';

// Darwesh Group — Firestore Security Rules
// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// Roles live on users/{uid}.role: "customer" (default, self-assigned at
// signup) or "agent" (assigned manually by you in the Firestore console —
// see the note in agent-dashboard.html / the chat for how).
//
// Every user and listing also carries a companyId (see companies/{id}
// below) — the foundation for eventually hosting more than one real
// estate company on this same platform, each with its own agents/team
// visibility. signup.html asks for a company name and creates the
// company doc automatically the first time that name is used — every
// signup after that with the same name just joins it, no manual
// Firestore edit needed. Public browsing (Map/Buy) still pools all
// companies' listings together — only the agent-facing Team Listings
// view is scoped per company so far.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAgent() { return myRole() == 'agent'; }
    function isAdmin() { return myRole() == 'admin'; }
    function myCompanyId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        : null;
    }

    // ---- Companies ----
    // A real estate company using this platform. Every user and listing
    // is tagged with a companyId. Any signed-in user can CREATE a new
    // company doc — that's how signup.html auto-creates one the first
    // time a name is used — but only if it doesn't already exist, so a
    // later signup can't overwrite an established company's name.
    // Editing or deleting an existing company is admin-only.
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/companies/$(companyId));
      allow update, delete: if isAdmin();
    }

    // ---- User profiles ----
    // Anyone signed in can read/create their own profile. An AGENT's
    // profile (name/email/photoURL) is publicly readable, even by a
    // guest with no account — listing.html shows the listing agent's
    // name and photo to every visitor, most of whom are browsing
    // anonymously, and agentName is already denormalized onto the public
    // `listings` collection anyway, so this isn't exposing anything new.
    // A customer's own profile stays private (isOwner/isAdmin only). A
    // user can update their own profile but NOT change their own role,
    // company, or assign themselves an agent (all three are set by you,
    // manually, in the Firestore console — see the note in
    // agent-dashboard.html / the chat for how). Only an admin profile
    // can change someone else's role, company, or agent assignment.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || resource.data.role == 'agent';
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      allow update: if (isOwner(uid)
                          && request.resource.data.role == resource.data.role
                          && request.resource.data.assignedAgentId == resource.data.assignedAgentId
                          && request.resource.data.companyId == resource.data.companyId)
                    || isAdmin();
      allow delete: if isAdmin();

      // Per-user favorites and saved searches — only that user (ever) reads/writes.
      match /favorites/{listingId} {
        allow read, write: if isOwner(uid);
      }
      match /savedSearches/{searchId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Listings ----
    // Publicly readable (Map/Buy show these to every visitor, logged in
    // or not) — this platform doesn't yet separate public browsing by
    // company, only the agent-facing Team Listings view does that. Only
    // an agent can create a listing (assigned to themself and tagged
    // with their own company), and only that same agent — or an admin —
    // can edit/delete it.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if (isAgent()
                          && request.resource.data.agentId == request.auth.uid
                          && request.resource.data.companyId == myCompanyId())
                    || isAdmin();
      allow update, delete: if (isAgent() && resource.data.agentId == request.auth.uid) || isAdmin();
    }

    // ---- Submissions (Sell form, viewing requests) ----
    // A signed-in customer can create a submission tagged with their own
    // uid, and can only ever read their own submissions back. A viewing
    // request (map.html) may also be submitted by a guest (uid == null) —
    // Request Viewing doesn't require an account. Only an admin can read
    // the full collection (Customer Services tab in admin.html) or change
    // a submission's status.
    match /submissions/{submissionId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.type in ['sell', 'viewing']
                    && (request.resource.data.uid == null
                        || (isSignedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
