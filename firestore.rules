rules_version = '2';

// Darwesh Group — Firestore Security Rules
// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// Roles live on users/{uid}.role: "customer" (default, self-assigned at
// signup) or "agent" (assigned manually by you in the Firestore console —
// see the note in agent-dashboard.html / the chat for how).
//
// Every user and listing also carries a companyId (see companies/{id}
// below) — the foundation for eventually hosting more than one real
// estate company on this same platform, each with its own agents/team
// visibility. signup.html asks for a company name and creates the
// company doc automatically the first time that name is used — every
// signup after that with the same name just joins it, no manual
// Firestore edit needed. Public browsing (Map/Buy) still pools all
// companies' listings together — only the agent-facing Team Listings
// view is scoped per company so far.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAgent() { return myRole() == 'agent'; }
    function isAdmin() { return myRole() == 'admin'; }
    function myCompanyId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        : null;
    }

    // ---- Companies ----
    // A real estate company using this platform. Every user and listing
    // is tagged with a companyId. Any signed-in user can CREATE a new
    // company doc — that's how signup.html auto-creates one the first
    // time a name is used — but only if it doesn't already exist, so a
    // later signup can't overwrite an established company's name.
    // Editing or deleting an existing company is admin-only.
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/companies/$(companyId));
      allow update, delete: if isAdmin();
    }

    // ---- User profiles ----
    // Anyone signed in can read/create their own profile. An AGENT's
    // profile (name/email/photoURL) is publicly readable, even by a
    // guest with no account — listing.html shows the listing agent's
    // name and photo to every visitor, most of whom are browsing
    // anonymously, and agentName is already denormalized onto the public
    // `listings` collection anyway, so this isn't exposing anything new.
    // A customer's own profile stays private (isOwner/isAdmin only). A
    // user can update their own profile but NOT change their own role,
    // company, or assign themselves an agent (all three are set by you,
    // manually, in the Firestore console — see the note in
    // agent-dashboard.html / the chat for how). Only an admin profile
    // can change someone else's role, company, or agent assignment.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || resource.data.role == 'agent';
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      allow update: if (isOwner(uid)
                          && request.resource.data.role == resource.data.role
                          && request.resource.data.assignedAgentId == resource.data.assignedAgentId
                          && request.resource.data.companyId == resource.data.companyId)
                    || isAdmin();
      allow delete: if isAdmin();

      // Per-user favorites and saved searches — only that user (ever) reads/writes.
      match /favorites/{listingId} {
        allow read, write: if isOwner(uid);
      }
      match /savedSearches/{searchId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Listing location privacy (LOC-01) ----
    // A listing document is `allow read: if true` (below), so EVERY field on
    // it is readable by every anonymous visitor. Firestore rules are
    // document-level for reads — a rule can deny the whole document, but it
    // can never hand it back with one field removed. So the only way to stop
    // publishing a property's exact, building-level coordinate is for that
    // coordinate not to be on the public document at all:
    //
    //   listings/{id}                  -> publicLat/publicLng, rounded to
    //                                     2 dp (~1.1 km) by
    //                                     js/listing-location.js
    //   listings/{id}/private/location -> the real lat/lng
    //
    // This is the invariant that actually closes LOC-01. It is applied to
    // both create and update, OUTSIDE the per-role branches, so it binds the
    // admin branch too — "no public listing document carries a
    // building-level coordinate" is structural, not something each client is
    // trusted to honour.
    //
    // Note this rule alone does NOT close the exposure: listings written
    // before it still carry lat/lng until scripts/backfill-public-coords.mjs
    // strips them. The rule stops the bleeding; the backfill cleans up.
    function hasNoPreciseCoordFields() {
      return !('lat' in request.resource.data) && !('lng' in request.resource.data);
    }
    function isValidPublicCoordPair(d) {
      return (!('publicLat' in d) || ((d.publicLat is int || d.publicLat is float) && d.publicLat >= -90 && d.publicLat <= 90))
          && (!('publicLng' in d) || ((d.publicLng is int || d.publicLng is float) && d.publicLng >= -180 && d.publicLng <= 180));
    }
    // Read/write gate for `listings/{id}/private/location`. Mirrors the
    // parent listing's own update rule EXACTLY — owning agent, or admin —
    // but reads the parent via get(), since `resource.data` inside a
    // subcollection rule refers to the sub-document, not to the listing.
    //
    // Deliberately no companyId branch: on this platform a colleague at the
    // same company cannot edit another agent's listing (see `allow update`
    // below), so granting them the exact pin would WIDEN access beyond the
    // current model rather than mirror it.
    //
    // Fails closed when the parent doesn't exist. That also forces the
    // correct write ordering — create the listing first, then its location
    // doc — since rules evaluate each write against pre-commit state, and it
    // stops an orphan location document being created for a listing id that
    // was never published.
    function canAccessListingPreciseLocation(listingId) {
      return exists(/databases/$(database)/documents/listings/$(listingId))
          && (
            isAdmin()
            || (isAgent() && get(/databases/$(database)/documents/listings/$(listingId)).data.agentId == request.auth.uid)
          );
    }

    // ---- Listings ----
    // Publicly readable (Map/Buy show these to every visitor, logged in
    // or not) — this platform doesn't yet separate public browsing by
    // company, only the agent-facing Team Listings view does that. Only
    // an agent can create a listing (assigned to themself and tagged
    // with their own company), and only that same agent — or an admin —
    // can edit/delete it.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if hasNoPreciseCoordFields()
                    && isValidPublicCoordPair(request.resource.data)
                    && ((isAgent()
                          && request.resource.data.agentId == request.auth.uid
                          && request.resource.data.companyId == myCompanyId())
                        || isAdmin());
      allow update: if hasNoPreciseCoordFields()
                    && isValidPublicCoordPair(request.resource.data)
                    && ((isAgent() && resource.data.agentId == request.auth.uid) || isAdmin());
      allow delete: if (isAgent() && resource.data.agentId == request.auth.uid) || isAdmin();

      // The exact surveyed pin, split off the public document so it can be
      // access-controlled at all. `match /listings/{listingId}` above is a
      // single-segment match, so it does NOT cascade here — this
      // subcollection is deny-by-default to everyone except the rule below,
      // and a public visitor has no partial-read path to it.
      match /private/location {
        allow read: if canAccessListingPreciseLocation(listingId);
        // Whoever may edit the parent listing may set its pin. The parent
        // must already exist (see canAccessListingPreciseLocation), so the
        // listing is written first and this second — which is exactly what
        // admin.html and agent-dashboard.html do.
        allow create, update: if canAccessListingPreciseLocation(listingId)
                              && request.resource.data.keys().hasOnly(['lat', 'lng', 'updatedAt'])
                              && (request.resource.data.lat is int || request.resource.data.lat is float)
                              && (request.resource.data.lng is int || request.resource.data.lng is float)
                              && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                              && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
        allow delete: if canAccessListingPreciseLocation(listingId);
      }
    }

    // ---- Submissions (Sell form, viewing requests) ----
    // A signed-in customer can create a submission tagged with their own
    // uid, and can only ever read their own submissions back. A viewing
    // request (map.html) may also be submitted by a guest (uid == null) —
    // Request Viewing doesn't require an account. Only an admin can read
    // the full collection (Customer Services tab in admin.html) or change
    // a submission's status.
    match /submissions/{submissionId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.type in ['sell', 'viewing']
                    && (request.resource.data.uid == null
                        || (isSignedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      // sell.html starts uploading photos (and the verification selfie) the
      // moment they're added/captured, not when Submit is finally clicked --
      // whatever hasn't finished by submit time keeps uploading in the
      // background and patches this same doc afterward, so listing creation
      // never blocks on Storage. That background patch runs as the same
      // unauthenticated guest who created the submission (sell.html has no
      // login requirement), so it can't be limited to isAdmin() the way
      // other updates are -- narrowed instead to touching only the photo
      // fields, and only while the submission is still pending (an admin
      // has full update rights regardless, e.g. once they start reviewing).
      allow update: if isAdmin()
                    || (resource.data.status == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['photoUrls', 'photoUploadToken', 'verificationPhotoPath']));
      allow delete: if isAdmin();
    }

    // ---- Agent financial ledger (accounting) ----
    // Each agent's own manually-entered income/expense/purchase records
    // for the Finances tab on agent-dashboard.html. Commission entries are
    // never stored here — they're calculated live from that agent's real
    // closed listings instead. Strictly owner-only: no agent can read or
    // write another agent's numbers; only an admin can read across all of
    // them.
    match /agentTransactions/{transactionId} {
      allow read: if isOwner(resource.data.agentId) || isAdmin();
      allow create: if isAgent() && request.resource.data.agentId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.agentId) || isAdmin();
    }
  }
}
