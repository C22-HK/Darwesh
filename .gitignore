# Credentials and environment. Nothing resembling a key, token, or
# service-account file belongs in this repository.
.env
.env.*
*.env
env.yaml
serviceAccount*.json
*-service-account*.json
application_default_credentials.json

# LOC-01: the backfill dry-run record lists every listing's EXACT
# coordinate. It is the rollback source of truth and must stay outside
# version control -- committing it would re-publish exactly what LOC-01
# removes.
loc1-preapply-record*.txt
*-coordinate-record*.txt

# Python virtualenvs (backend tooling)
.venv/
backend/.venv/
__pycache__/

# OS/editor noise
.DS_Store
Thumbs.db
