node_modules/

# Generated by scripts/build-public.mjs -- the public website artifact
# GitHub Pages publishes. Rebuilt from source on every deploy, so it is
# never committed; committing it would also reintroduce the risk of a
# stale copy shipping files the current allowlist would exclude.
dist/

firestore-debug.log
ui-debug.log
firebase-debug.log
.firebase/

# Generated locally from js/maps-config.local.example.js (or by
# .github/workflows/deploy-pages.yml from the GOOGLE_MAPS_BROWSER_KEY
# repo secret at deploy time) -- never committed. See that example file
# and docs/GOOGLE_MAPS_CONFIGURATION.md for why.
js/maps-config.js

# Local Playwright QA screenshots from ad-hoc browser QA passes -- never
# committed (temp verification artifacts, not part of the site).
scratchpad-qa/
